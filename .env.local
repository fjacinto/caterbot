# ---------------------------------------------------------------
# Katerbot — environment variables (copy to .env.local, never commit real keys)
# ---------------------------------------------------------------

# --- SQL Server 2025 (Developer/Enterprise) ---
# Leave empty to run in OFFLINE mode with a local JSON store (data/dev-store.json).
# Example (SQL auth):
# SQLSERVER_CONNECTION_STRING=Server=localhost,1433;Database=Katerbot;User Id=katerbot_app;Password=<secret>;Encrypt=true;TrustServerCertificate=true
SQLSERVER_CONNECTION_STRING=

# --- Reap Agentic Payments ---
# Leave REAP_API_KEY empty to use MOCK mode (clearly labeled in the UI).
# Sandbox hosts: https://sandbox.api.reap.global | https://mx.sandbox.api.reap.global
REAP_BASE_URL=https://mx.sandbox.api.reap.global
REAP_API_KEY=
REAP_VERSION=2025-02-14
# Auth header style: "bearer" (Authorization: Bearer <key>, per Reap docs) or "x-api-key"
REAP_AUTH_STYLE=bearer
# Sandbox only: sends X-Simulate-Checkout: COMPLETED on checkouts. Rejected in production — leave empty there.
REAP_SIMULATE_CHECKOUT=
# Pricing context for product search
REAP_COUNTRY=MX
REAP_CURRENCY=MXN

# Public URL of this app (used for Reap redirect return URLs)
APP_BASE_URL=http://localhost:3000
